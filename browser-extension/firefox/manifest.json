{
  "manifest_version": 3,
  "name": "godl",
  "version": "1.0.0",
  "description": "Sends downloads from this browser to godl, your download manager.",

  "background": {
    "scripts": ["background.js"]
  },

  "permissions": [
    "nativeMessaging",
    "downloads",
    "notifications",
    "cookies",
    "storage",
    "contextMenus"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "godl@davdigi.com",
      "strict_min_version": "121.0"
    }
  }
}
